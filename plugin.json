{
  "manifestVersion": 2,
  "name": "codex-candy-eval",
  "displayName": "Codex 降智与指纹测试",
  "publisher": "nmbb",
  "version": "1.1.3",
  "description": "CPR（codex-proxy-rs）原生 Rust 插件：Codex 账号降智检测、模型指纹对比、深度追踪与鹈鹕绘图测试套件（魔改移植自 cpa-plugin-codex-candy-eval）",
  "license": "MIT",
  "author": "nmbb",
  "engines": {
    "codex-proxy-rs": ">=3.28.0, <4.0.0"
  },
  "main": "bin/plugin",
  "runtime": "trustedProcess",
  "contributes": {
    "management": {},
    "command_line": {},
    "maintenance": {}
  },
  "configurationSchema": {
    "type": "object",
    "properties": {
      "api_base_url": {
        "type": "string",
        "title": "CPR 本机接口地址",
        "description": "插件与 CPR 共用网络命名空间。仅接受回环 IP，不接受域名、认证或路径；默认无需填写。",
        "default": "http://127.0.0.1:8080"
      }
    },
    "additionalProperties": false
  },
  "resources": {
    "web/ui.html": "text/html",
    "web/theme.css": "text/css",
    "web/style.css": "text/css",
    "web/vendor/temml.css": "text/css",
    "web/vendor/temml-fc70501355ae.woff2": "font/woff2",
    "web/vendor/temml-d065b0c621f6.svg": "image/svg+xml",
    "web/assets/bg-98826c21ff06.svg": "image/svg+xml"
  },
  "state": [
    {
      "namespace": "candy-eval",
      "schemaVersion": 1,
      "schema": {
        "type": "object"
      },
      "maximumRecords": 40,
      "maximumBytes": 2097152,
      "maximumValueBytes": 262144,
      "migratesFrom": []
    }
  ]
}
